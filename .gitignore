!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.vsidx
.vshistory/

## =============================================================
##  Secrets & local configuration  (DO NOT COMMIT)
## =============================================================
*.env
.env.*
!.env.example
appsettings.*.local.json
appsettings.Development.json
secrets.json
*.pfx
*.key
*.pem

## =============================================================
##  Docker (keep compose files; ignore local overrides)
## =============================================================
docker-compose.override.local.yml
.docker/

## =============================================================
##  OS junk
## =============================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

